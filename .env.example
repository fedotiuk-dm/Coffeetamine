# Coffeetamine — environment variables (copy to `.env` or export in your shell)
#
# These defaults match `docker-compose.dev.yml` so a fresh clone + `make up` + `make dev`
# works without touching anything. Override only what you need.

# ── App ────────────────────────────────────────────────────────────────────────
SERVER_PORT=8090
SPRING_PROFILES_ACTIVE=dev
TRACING_SAMPLING=1.0

# ── App database (Postgres) ───────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/coffeetamine
DB_USERNAME=coffeetamine
DB_PASSWORD=coffeetamine

# ── OIDC Resource Server ──────────────────────────────────────────────────────
# Issuer URI used by the backend to fetch OIDC discovery metadata and JWKS.
OIDC_ISSUER_URI=http://localhost:8081/default
OIDC_AUDIENCE=coffeetamine-api

# Comma-separated allowlist that grants ROLE_ADMIN in addition to ROLE_USER.
APP_ADMIN_EMAILS=admin@coffeetamine.local

# ── Logging ───────────────────────────────────────────────────────────────────
# Override component-level log levels without editing application-dev.yml.
# LOGGING_LEVEL_UA_COFFEETAMINE=DEBUG
# LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=DEBUG
