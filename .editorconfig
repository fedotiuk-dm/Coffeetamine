# EditorConfig — https://editorconfig.org
# Aligned with Google Java Format (Spotless) and the existing yaml/json style.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 2
max_line_length = 120

[*.{yaml,yml,json}]
indent_size = 2

[*.xml]
indent_size = 4

[Makefile]
indent_style = tab
